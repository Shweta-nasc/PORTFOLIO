# =============================================================================
# Environment Variables
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# ---- EmailJS (contact form) -------------------------------------------------
# Create a free account at https://www.emailjs.com/ and grab these values.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ---- Site URL (used for SEO / canonical / OpenGraph) ------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Coding dashboard: usernames (single source is src/config/profile.ts) ---
# These override the committed defaults in src/config/profile.ts. Public data
# only — no secrets, safe to expose client-side.
NEXT_PUBLIC_GITHUB_USERNAME=your_github_username
NEXT_PUBLIC_LEETCODE_USERNAME=your_leetcode_username
NEXT_PUBLIC_CODEFORCES_USERNAME=your_codeforces_handle
NEXT_PUBLIC_GEEKSFORGEEKS_USERNAME=your_gfg_username

# ---- Optional: GitHub contribution heatmap ----------------------------------
# SERVER-ONLY (never exposed to the browser). When set, the /api/github/
# contributions route uses the OFFICIAL GitHub GraphQL contribution calendar.
# If left unset, it falls back to a public tokenless proxy so the heatmap still
# works out of the box. A classic PAT with no scopes (public data) is enough.
GITHUB_TOKEN=
